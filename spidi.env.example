# Variables de la tienda (Gift Cards pagadas con SPIDI). Copia este archivo a
# spidi.env para trabajar en local (spidi.env esta en .gitignore y el servidor
# lo lee al arrancar); en Railway van en las Variables del servicio. Aqui no hay
# valores reales: nunca subas al repo un token, una clave ni el webhook secret.
# Las variables vacias se ignoran.

# URL base de la API de SPIDI: https://sim.mispidi.com (simulador), https://sandbox.api.spidipagos.com (sandbox) o la de produccion (la entrega SPIDI con las credenciales finales).
SPIDI_BASE_URL=
# En produccion real debe valer exactamente: produccion. En cualquier otro caso (simulador, sandbox, local, staging) dejala vacia.
# Los pagos solo son reales con SPIDI_ENTORNO=produccion Y una SPIDI_BASE_URL https cuyo host no sea de prueba.
# Hosts de prueba conocidos (ver esHostDePrueba en server/spidi.ts): el simulador, el sandbox, abiertolab.com, localhost, una IP, dominios .test/.local/.localhost/.internal/.example/.invalid,
# un host con "sandbox" o "mock" en cualquier parte del nombre, o con una de estas palabras sueltas en una etiqueta (separadas por ".", "-" o "_", con o sin un número al final como "qa1" o "uat2"):
# sim, simulador, test, testing, prueba, pruebas, staging, stage, stg, preprod, uat, certificacion, dev, desarrollo, qa, demo, local.
# Con un host de prueba conocido la tienda queda en MODO PRUEBA: pedidos TVP-, Gift Cards PRUEBA- que no se pueden canjear (si dice produccion, manda la URL y el arranque registra un error de configuracion).
# Cualquier otra combinacion es un entorno DESCONOCIDO (por ejemplo la URL de produccion con esta variable vacia o mal escrita, o con http://):
# el checkout responde 503 SIEMPRE, aunque haya SPIDI_PERMITIR_PRUEBAS=1 o NODE_ENV=development, y el arranque registra un error de configuracion.
SPIDI_ENTORNO=
# Solo simulador: token fijo de la API (lo guarda "npm run spidi:simulador"). En sandbox y produccion se deja vacio y se usa login.
SPIDI_API_TOKEN=
# Solo simulador: id de la cuenta de prueba (lo guarda "npm run spidi:simulador"); sirve para revisar sus avisos en la consola del simulador.
SPIDI_ACCOUNT_ID=
# Solo simulador: token de la consola del simulador (/console/**), no de la API; lo guarda "npm run spidi:simulador". El servidor no lo usa.
SPIDI_CONSOLE_TOKEN=
# Sandbox y produccion: usuario (short_name) que entrega SPIDI para el login.
SPIDI_SHORT_NAME=
# Sandbox y produccion: contrasena de ese usuario.
SPIDI_PASSWORD=
# Id del acuerdo de liquidacion por el que se cobra (lo crea y guarda "npm run spidi:acuerdo"; uno por entorno).
SPIDI_AGREEMENT_ID=
# UUID de la cuenta bancaria donde se liquida; solo lo usa "npm run spidi:acuerdo" (en el simulador es uuid_banco_001).
SPIDI_BANK_ACCOUNT_ID=
# Secreto para verificar la firma (spidi-signature) de los avisos de SPIDI; sin el, el webhook responde 503.
SPIDI_WEBHOOK_SECRET=
# Minutos que vive el enlace de pago, de 5 a 20 (por defecto 15).
SPIDI_DURACION_MINUTOS=
# Pon 1 solo en un staging: permite cobrar en modo prueba con NODE_ENV=production; sin el, si no es produccion confirmada, el checkout responde 503.
# Solo abre hosts de prueba conocidos (ver arriba): con un entorno desconocido el checkout sigue cerrado.
# (El nombre viejo SPIDI_PERMITIR_SIMULADOR=1 se sigue aceptando, pero usa este.)
SPIDI_PERMITIR_PRUEBAS=
# URL publica del sitio para volver de SPIDI y recibir los avisos; en produccion con www: https://www.todovendingca.com
PUBLIC_BASE_URL=
# Clave de la API de Resend para los correos de la compra y los avisos de venta.
RESEND_API_KEY=
# Remitente de los correos, con dominio verificado en Resend, por ejemplo: Todo Vending CA <pedidos@todovendingca.com>
EMAIL_FROM=
# Clave para las rutas /api/admin (cabecera x-admin-key); sin ella la administracion queda cerrada.
ADMIN_KEY=
# Conexion a Postgres; sin ella los pedidos viven en memoria y en produccion el checkout se cierra.
DATABASE_URL=
