# ======== TodoWeb Digital — variables de entorno ========
# Copia este archivo a .env (local) o cárgalo en Railway > Variables.

# URL pública canónica del sitio (sin barra final).
NEXT_PUBLIC_SITE_URL=https://www.todowebdigital.com

# Postgres (Neon, Railway, Supabase...). Si falta, el sitio arranca igual pero
# guarda los datos en data/store.json y se PIERDEN en cada despliegue.
DATABASE_URL=

# Contraseña del panel /admin (obligatoria para entrar al panel).
ADMIN_PASSWORD=
# Secreto largo y aleatorio para firmar la cookie de sesión del panel.
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Clave de la API de Claude (Anthropic) para generar artículos del blog.
ANTHROPIC_API_KEY=
# Modelo a usar (opcional). Por defecto: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Correo de avisos del formulario de contacto (Resend). Opcional.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
# Remitente verificado en Resend. Si no tienes dominio verificado usa onboarding@resend.dev
CONTACT_EMAIL_FROM=TodoWeb Digital <onboarding@resend.dev>
